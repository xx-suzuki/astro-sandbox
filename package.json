{
  "name": "astro-sandbox",
  "type": "module",
  "version": "0.0.1",
  "author": "xx-suzuki",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/xx-suzuki/astro-sandbox/issues"
  },
  "homepage": "https://github.com/xx-suzuki/astro-sandbox#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xx-suzuki/astro-sandbox.git"
  },
  "engines": {
    "node": "^22.18.0"
  },
  "scripts": {
    "dev": "run-s dev:clean dev:plop:scss dev:copy dev:img dev:svg && run-p dev:astro \"watch:*\"",
    "dev:astro": "astro dev",
    "dev:copy": "cross-env NODE_ENV=development tsx cli/static-copy.ts",
    "dev:svg": "cross-env NODE_ENV=development tsx cli/svg-sprite.ts",
    "dev:img": "cross-env NODE_ENV=development tsx cli/image-min.ts",
    "dev:clean": "cross-env NODE_ENV=development tsx cli/clean-up.ts",
    "dev:plop:scss": "cross-env NODE_ENV=development npm run plop -- scss",
    "watch:copy": "onchange \"static/**\" -- npm run dev:copy \"{{changed}}\"",
    "watch:svg": "onchange \"src/assets/svg-sprite/*.svg\" -- npm run dev:svg \"{{changed}}\"",
    "watch:img": "onchange \"src/assets/images/**\" -- npm run dev:img \"{{changed}}\"",
    "build": "run-s build:clean build:svg build:plop:scss build:copy build:img build:astro build:vite build:fonts beautify:html",
    "build:astro": "astro build",
    "build:vite": "cross-env BUILD_BY=vite vite build",
    "build:copy": "cross-env NODE_ENV=production tsx cli/static-copy.ts",
    "build:svg": "cross-env NODE_ENV=production tsx cli/svg-sprite.ts",
    "build:img": "cross-env NODE_ENV=production tsx cli/image-min.ts",
    "build:fonts": "cross-env NODE_ENV=production tsx cli/relocate-astro-fonts.ts",
    "build:clean": "cross-env NODE_ENV=production tsx cli/clean-up.ts",
    "build:plop:scss": "cross-env NODE_ENV=production npm run plop -- scss",
    "beautify:html": "tsx cli/html-prettify.ts",
    "icon": "tsx cli/font-awesome.ts",
    "w3c": "tsx cli/validate-html.ts",
    "preview": "astro preview",
    "check": "run-p \"check:*\"",
    "check:ts": "tsc --noEmit",
    "check:astro": "astro check",
    "fix": "run-p \"fix:*\"",
    "fix:eslint": "eslint -c eslint.config.ts \"./src/**/*.{ts,tsx,astro}\" --fix",
    "fix:stylelint": "stylelint --config .stylelintrc.mjs \"./src/**/*.{scss,css}\" --fix --aei",
    "fix:config": "eslint -c eslint.config.ts \"./*.{js,mjs,ts}\" --fix --no-error-on-unmatched-pattern && prettier --write --no-error-on-unmatched-pattern \"./*.{js,mjs,ts}\"",
    "fix:cli": "eslint -c eslint.config.ts \"./cli/**/*.ts\" --fix --no-error-on-unmatched-pattern && prettier --write --no-error-on-unmatched-pattern \"./cli/**/*.ts\"",
    "fix:prettier": "prettier --write --no-error-on-unmatched-pattern \"./**/*.{js,mjs,ts,tsx,astro,scss,css}\"",
    "lint-staged": "lint-staged",
    "plop": "cross-env NODE_OPTIONS=\"--import tsx\" plop --plopfile=plopfile.ts",
    "prepare": "husky",
    "mul": "markuplint --allow-warnings \"./src/**/*.astro\"",
    "test": "vitest run --passWithNoTests --coverage --reporter=verbose"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.6.1",
    "astro": "^5.16.9",
    "budoux": "^0.7.0",
    "destyle.css": "^4.0.1",
    "sass": "^1.97.2",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@eslint/js": "^9.39.2",
    "@inquirer/prompts": "^8.2.0",
    "@markuplint/astro-parser": "^4.6.22",
    "@tweakpane/core": "^2.0.5",
    "@tweakpane/plugin-essentials": "^0.2.1",
    "@types/fs-extra": "^11.0.4",
    "@types/js-beautify": "^1.14.3",
    "@types/node": "^25.0.7",
    "@types/svg-sprite": "^0.0.39",
    "@vitest/coverage-v8": "^4.0.17",
    "astro-eslint-parser": "^1.2.2",
    "autoprefixer": "^10.4.23",
    "cross-env": "^10.1.0",
    "eslint": "9.39.2",
    "eslint-plugin-astro": "^1.5.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^5.3.1",
    "eslint-plugin-unicorn": "^62.0.0",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.3.3",
    "glob": "^13.0.0",
    "globals": "^17.0.0",
    "html-validate": "^10.5.0",
    "husky": "^9.1.7",
    "image-size": "^2.0.2",
    "jiti": "^2.6.1",
    "js-beautify": "^1.15.4",
    "lint-staged": "^16.2.7",
    "markuplint": "^4.9.2",
    "npm-run-all": "^4.1.5",
    "onchange": "^7.1.0",
    "picocolors": "^1.1.1",
    "plop": "^4.0.4",
    "postcss": "^8.5.6",
    "postcss-sort-media-queries": "^5.2.0",
    "prettier": "^3.7.4",
    "prettier-plugin-astro": "^0.14.1",
    "pretty-bytes": "^7.1.0",
    "rollup-plugin-visualizer": "^6.0.5",
    "sharp": "^0.34.5",
    "stylelint": "^16.26.1",
    "stylelint-config-recess-order": "^7.4.0",
    "stylelint-config-recommended-scss": "^16.0.2",
    "stylelint-order": "^7.0.1",
    "stylelint-prettier": "^5.0.3",
    "stylelint-scss": "^6.14.0",
    "svg-sprite": "^2.0.4",
    "svgo": "^4.0.0",
    "terser": "^5.44.1",
    "tsx": "^4.21.0",
    "tweakpane": "^4.0.5",
    "typescript-eslint": "^8.53.0",
    "vite-tsconfig-paths": "^6.0.4",
    "vitest": "^4.0.17"
  },
  "overrides": {
    "glob": "^13.0.0"
  }
}
