{
  "name": "astro-sandbox",
  "type": "module",
  "version": "0.0.1",
  "author": "xx-suzuki",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/xx-suzuki/astro-sandbox/issues"
  },
  "homepage": "https://github.com/xx-suzuki/astro-sandbox#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xx-suzuki/astro-sandbox.git"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "^12.0.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "run-s dev:clean dev:plop:scss dev:copy dev:svg dev:img && run-p dev:astro \"watch:*\"",
    "dev:astro": "astro dev",
    "dev:copy": "tsx scripts/node/commands/static-copy.ts -- -d",
    "dev:svg": "tsx scripts/node/commands/svg-sprite.ts -- -d",
    "dev:img": "tsx scripts/node/commands/image-min.ts -- -d",
    "dev:clean": "tsx scripts/node/commands/clean-up.ts -- -d",
    "dev:plop:scss": "cross-env NODE_ENV=development pnpm run plop -- scss",
    "watch:copy": "tsx scripts/node/commands/static-copy.ts -- -w",
    "watch:svg": "tsx scripts/node/commands/svg-sprite.ts -- -w",
    "watch:img": "tsx scripts/node/commands/image-min.ts -- -w",
    "build": "run-s build:clean build:plop:scss build:copy build:svg build:img build:astro build:vite build:fonts build:format:html",
    "build:astro": "astro build",
    "build:vite": "cross-env BUILD_BY=vite vite build",
    "build:copy": "tsx scripts/node/commands/static-copy.ts",
    "build:svg": "tsx scripts/node/commands/svg-sprite.ts",
    "build:img": "tsx scripts/node/commands/image-min.ts",
    "build:fonts": "tsx scripts/node/commands/relocate-astro-fonts.ts",
    "build:clean": "tsx scripts/node/commands/clean-up.ts",
    "build:plop:scss": "cross-env NODE_ENV=production pnpm run plop -- scss",
    "build:format:html": "tsx scripts/node/commands/html-prettify.ts",
    "preview": "astro preview",
    "create:icon": "tsx scripts/node/commands/font-awesome.ts",
    "report:w3c": "run-s build:astro build:fonts build:format:html && tsx scripts/node/commands/validate-html.ts",
    "check": "run-p \"check:*\"",
    "check:ts": "tsc --noEmit",
    "check:astro": "astro check",
    "check:markup": "markuplint --allow-warnings \"./src/**/*.astro\"",
    "format": "run-s \"format:*\"",
    "format:eslint": "eslint -c eslint.config.ts \"./src/**/*.{ts,tsx,astro}\" --fix --cache --cache-location .cache/eslint/src",
    "format:stylelint": "stylelint --config .stylelintrc.mjs \"./src/**/*.{scss,css}\" --fix --aei --cache --cache-location .cache/stylelint/src",
    "format:config": "eslint -c eslint.config.ts \"./*.{js,mjs,ts}\" --fix --no-error-on-unmatched-pattern --cache --cache-location .cache/eslint/config && prettier --write --no-error-on-unmatched-pattern --cache --cache-location .cache/prettier/config \"./*.{js,mjs,ts}\"",
    "format:scripts": "eslint -c eslint.config.ts \"./scripts/node/**/*.ts\" --fix --no-error-on-unmatched-pattern --cache --cache-location .cache/eslint/scripts && prettier --write --no-error-on-unmatched-pattern --cache --cache-location .cache/prettier/scripts \"./scripts/node/**/*.ts\"",
    "format:prettier": "prettier --write --no-error-on-unmatched-pattern --cache --cache-location .cache/prettier/all \"./**/*.{js,mjs,ts,tsx,astro,scss,css}\"",
    "lint-staged": "lint-staged --concurrent false",
    "plop": "cross-env NODE_OPTIONS=\"--import tsx\" plop --plopfile=plopfile.ts",
    "prepare": "husky",
    "test": "vitest run --config vitest.config.ts --coverage --reporter=verbose",
    "test:scripts": "vitest run --config vitest.config.ts --project scripts",
    "test:frontend": "vitest run --config vitest.config.ts --project frontend --passWithNoTests"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.2",
    "budoux": "^0.10.0",
    "destyle.css": "^4.0.1",
    "sass": "^1.106.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@inquirer/prompts": "^8.7.4",
    "@markuplint/astro-parser": "^4.18.3",
    "@markuplint/ml-config": "^4.18.1",
    "@tweakpane/core": "^2.0.5",
    "@tweakpane/plugin-essentials": "^0.2.1",
    "@types/fs-extra": "^11.0.4",
    "@types/js-beautify": "^1.14.3",
    "@types/node": "^26.6.5",
    "@types/svg-sprite": "^0.0.39",
    "@vitest/coverage-v8": "^5.0.5",
    "astro-eslint-parser": "^3.2.0",
    "autoprefixer": "^10.6.1",
    "chokidar": "^6.0.0",
    "cross-env": "^10.1.0",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-unicorn": "^78.0.0",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.4.1",
    "globals": "^17.13.0",
    "html-validate": "^11.17.0",
    "husky": "^9.1.7",
    "image-size": "^2.0.4",
    "jiti": "^2.7.0",
    "js-beautify": "^2.0.3",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "markuplint": "^4.18.3",
    "npm-run-all2": "^9.0.3",
    "picocolors": "^1.1.1",
    "plop": "^4.0.5",
    "postcss": "^8.5.31",
    "postcss-sort-media-queries": "^6.7.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "pretty-bytes": "^7.2.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "sharp": "^0.35.5",
    "stylelint": "^17.16.0",
    "stylelint-config-recess-order": "^7.8.2",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-order": "^8.1.2",
    "stylelint-prettier": "^5.0.3",
    "stylelint-scss": "^7.3.0",
    "svg-sprite": "^2.0.4",
    "svgo": "^4.1.0",
    "terser": "^5.51.2",
    "tsx": "^4.23.15",
    "tweakpane": "^4.0.5",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
