{
  "name": "astro-sandbox",
  "type": "module",
  "version": "0.0.1",
  "author": "xx-suzuki",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/xx-suzuki/astro-sandbox/issues"
  },
  "homepage": "https://github.com/xx-suzuki/astro-sandbox#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xx-suzuki/astro-sandbox.git"
  },
  "engines": {
    "node": "^24.13.0"
  },
  "scripts": {
    "dev": "run-s dev:clean dev:plop:scss dev:copy dev:svg dev:img && run-p dev:astro watch:*",
    "dev:astro": "astro dev",
    "dev:copy": "tsx scripts/node/commands/static-copy.ts -- -d",
    "dev:svg": "tsx scripts/node/commands/svg-sprite.ts -- -d",
    "dev:img": "tsx scripts/node/commands/image-min.ts -- -d",
    "dev:clean": "tsx scripts/node/commands/clean-up.ts -- -d",
    "dev:plop:scss": "cross-env NODE_ENV=development npm run plop -- scss",
    "watch:copy": "tsx scripts/node/commands/static-copy.ts -- -w",
    "watch:svg": "tsx scripts/node/commands/svg-sprite.ts -- -w",
    "watch:img": "tsx scripts/node/commands/image-min.ts -- -w",
    "build": "run-s build:clean build:plop:scss build:copy build:svg build:img build:astro build:vite build:fonts beautify:html",
    "build:astro": "astro build",
    "build:vite": "cross-env BUILD_BY=vite vite build",
    "build:copy": "tsx scripts/node/commands/static-copy.ts",
    "build:svg": "tsx scripts/node/commands/svg-sprite.ts",
    "build:img": "tsx scripts/node/commands/image-min.ts",
    "build:fonts": "tsx scripts/node/commands/relocate-astro-fonts.ts",
    "build:clean": "tsx scripts/node/commands/clean-up.ts",
    "build:plop:scss": "cross-env NODE_ENV=production npm run plop -- scss",
    "beautify:html": "tsx scripts/node/commands/html-prettify.ts",
    "icon": "tsx scripts/node/commands/font-awesome.ts",
    "w3c": "tsx scripts/node/commands/validate-html.ts",
    "preview": "astro preview",
    "check": "run-p \"check:*\"",
    "check:ts": "tsc --noEmit",
    "check:astro": "astro check",
    "audit": "run-p \"audit:*\"",
    "audit:a11y": "run-s build:astro beautify:html w3c",
    "fix": "run-p \"fix:*\"",
    "fix:eslint": "eslint -c eslint.config.ts \"./src/**/*.{ts,tsx,astro}\" --fix",
    "fix:stylelint": "stylelint --config .stylelintrc.mjs \"./src/**/*.{scss,css}\" --fix --aei",
    "fix:config": "eslint -c eslint.config.ts \"./*.{js,mjs,ts}\" --fix --no-error-on-unmatched-pattern && prettier --write --no-error-on-unmatched-pattern \"./*.{js,mjs,ts}\"",
    "fix:cli": "eslint -c eslint.config.ts \"./scripts/node/**/*.ts\" --fix --no-error-on-unmatched-pattern && prettier --write --no-error-on-unmatched-pattern \"./scripts/node/**/*.ts\"",
    "fix:prettier": "prettier --write --no-error-on-unmatched-pattern \"./**/*.{js,mjs,ts,tsx,astro,scss,css}\"",
    "lint-staged": "lint-staged --concurrent false",
    "plop": "cross-env NODE_OPTIONS=\"--import tsx\" plop --plopfile=plopfile.ts",
    "prepare": "husky",
    "mul": "markuplint --allow-warnings \"./src/**/*.astro\"",
    "test": "vitest run --config vitest.config.ts --coverage --reporter=verbose",
    "test:cli": "vitest run --config vitest.config.ts --project cli",
    "test:frontend": "vitest run --config vitest.config.ts --project frontend --passWithNoTests"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.0",
    "astro": "^5.17.3",
    "budoux": "^0.7.0",
    "destyle.css": "^4.0.1",
    "sass": "^1.97.3",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@eslint/js": "^9.0.0",
    "@inquirer/prompts": "^8.2.1",
    "@markuplint/astro-parser": "^4.6.23",
    "@tweakpane/core": "^2.0.5",
    "@tweakpane/plugin-essentials": "^0.2.1",
    "@types/fs-extra": "^11.0.4",
    "@types/js-beautify": "^1.14.3",
    "@types/node": "^25.3.0",
    "@types/svg-sprite": "^0.0.39",
    "@vitest/coverage-v8": "^4.0.18",
    "astro-eslint-parser": "^1.3.0",
    "autoprefixer": "^10.4.24",
    "cross-env": "^10.1.0",
    "eslint": "9.39.3",
    "eslint-plugin-astro": "^1.6.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^5.6.0",
    "eslint-plugin-unicorn": "^63.0.0",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.3.3",
    "glob": "^13.0.6",
    "globals": "^17.3.0",
    "html-validate": "^10.8.0",
    "husky": "^9.1.7",
    "image-size": "^2.0.2",
    "jiti": "^2.6.1",
    "jsdom": "^27.0.1",
    "js-beautify": "^1.15.4",
    "lint-staged": "^16.2.7",
    "markuplint": "^4.14.1",
    "npm-run-all": "^4.1.5",
    "picocolors": "^1.1.1",
    "plop": "^4.0.5",
    "postcss": "^8.5.6",
    "postcss-sort-media-queries": "^5.2.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "pretty-bytes": "^7.1.0",
    "rollup-plugin-visualizer": "^7.0.0",
    "sharp": "^0.34.5",
    "stylelint": "^17.3.0",
    "stylelint-config-recess-order": "^7.6.1",
    "stylelint-config-recommended-scss": "^17.0.0",
    "stylelint-order": "^7.0.1",
    "stylelint-prettier": "^5.0.3",
    "stylelint-scss": "^7.0.0",
    "svg-sprite": "^2.0.4",
    "svgo": "^4.0.0",
    "terser": "^5.46.0",
    "tsx": "^4.21.0",
    "tweakpane": "^4.0.5",
    "typescript-eslint": "^8.56.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18"
  }
}
