---
import { assetsDir, baseDir, imgDir, siteUrl } from '@root/project.config';
import { Font } from 'astro:assets';

import Footer from '@/components/projects/Footer.astro';
import Header from '@/components/projects/Header.astro';
interface Props {
  description: string;
  id: string;
  keywords?: string;
  ogImage?: string;
  ogType?: 'article' | 'blog' | 'product' | 'profile' | 'website';
  title: string;
}

const {
  description,
  id,
  keywords,
  ogImage = '/ogp.png',
  ogType = 'website',
  title,
} = Astro.props;

const url = new URL(Astro.url.pathname, Astro.site);
const ogp = siteUrl + imgDir + ogImage;
---

<html lang="ja">
  <head>
    <meta charset="utf-8">
    <meta content="width=device-width" name="viewport">
    <meta content="email=no,telephone=no,address=no" name="format-detection">
    <meta content={description} name="description">
    {keywords && <meta content={keywords} name="keywords" />}
    <meta content="ja_JP" property="og:locale">
    <meta content={ogType} property="og:type">
    <meta content={title} property="og:title">
    <meta content={title} property="og:site_name">
    <meta content={description} property="og:description">
    <meta content={url} property="og:url">
    <meta content={ogp} property="og:image">
    <meta content="1200" property="og:image:width">
    <meta content="630" property="og:image:height">
    <meta content="summary_large_image" name="twitter:card">
    <meta content={url} name="twitter:url">
    <meta content={title} name="twitter:title">
    <meta content={description} name="twitter:description">
    <meta content={ogp} name="twitter:image">
    <meta content={ogp} name="thumbnail">
    <meta content="#FFFFFF" name="theme-color">
    <title>{ title }</title>
    <link href={url} rel="canonical">
    <Font cssVariable="--font-main" />
    {import.meta.env.PROD && <link href={`${baseDir}${assetsDir.styles.outDir}/${assetsDir.styles.outName}.css`} rel="stylesheet" />}
    {import.meta.env.DEV ?
      (
      <script is:inline src="/src/main.ts" type="module"></script>
      ) : (
      <script is:inline src={`${baseDir}${assetsDir.javascript.outDir}/${assetsDir.javascript.outName}.js`} type="module"></script>
      )
    }
  </head>
  <body class={`p-${id}`} id={id}>
    <div class="l-wrapper" id="wrap">
      <div class="l-wrapper__header">
        <Header />
      </div>
      <main class="l-wrapper__contents">
        <slot />
      </main>
      <div class="l-wrapper__footer">
        <Footer />
      </div>
    </div>
  </body>
</html>
