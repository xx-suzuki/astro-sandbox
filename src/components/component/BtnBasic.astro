---
import type { HTMLAttributes } from 'astro/types';

import SvgSprite from '@/components/component/SvgSprite.astro';
import { blankAttribute } from '@/helper/node/utils';
interface Props {
  addClass?: string;
  anchor: Omit<HTMLAttributes<'a'>, 'href'> & {
    href: string;
  };
  modifier?: string;
  target?: boolean;
  text?: string;
}

const { addClass, anchor, modifier, target = false, text = 'details' } = Astro.props;
const anchorAttribute = target ? { ...anchor, ...blankAttribute(target) } : anchor;
const addModifier = modifier ? `c-btn-basic--${modifier}` : '';
---

<div class:list={['c-btn-basic', addClass, addModifier]}>
  <a class="c-btn-basic__link" {...anchorAttribute}>
    <span class="c-btn-basic__text">{text}</span>
    <SvgSprite class="c-btn-basic__icon" hash="logo-x" />
  </a>
</div>
