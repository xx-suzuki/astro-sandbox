---
import type { HTMLAttributes } from 'astro/types';

import { getImageData } from '@/helper/node/image';
import { getFileData } from '@/helper/node/path';
export type Props = Omit<HTMLAttributes<'img'>, 'src'> & {
  pictureProps?: HTMLAttributes<'picture'>;
  src: string;
};
const { alt = '', pictureProps, src, ...restProps } = Astro.props;
const { height, width } = getImageData(src);
const { assetDir, ext, name } = getFileData(src);

const attribute = {
  height,
  width,
  ...restProps,
};
---

<picture {...pictureProps}>
  {
    ext !== '.svg' && (
      <source height={height} srcset={`${assetDir}/${name}.avif`} type="image/avif" width={width} />
    )
  }
  <img
    alt={alt}
    decoding="async"
    src={ext === '.svg' ? src : `${assetDir}/${name}${ext}`}
    {...attribute}
  />
</picture>
