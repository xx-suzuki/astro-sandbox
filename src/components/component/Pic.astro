---
import type { HTMLAttributes } from 'astro/types';

import { breakpoints } from '@root/project.config';

import { getImageData } from '@/helper/node/image';
import { getFileData } from '@/helper/node/path';
export interface Props {
  imageProps?: Omit<HTMLAttributes<'img'>, 'src'>;
  pictureProps?: HTMLAttributes<'picture'>;
  srcPc: string;
  srcSp: string;
}
const { imageProps, pictureProps, srcPc, srcSp } = Astro.props;
const size = {
  pc: getImageData(srcPc),
  sp: getImageData(srcSp),
};
const data = {
  pc: getFileData(srcPc),
  sp: getFileData(srcSp),
};

const alt = imageProps?.alt ?? '';
if (imageProps?.alt) {
  delete imageProps.alt;
}

const attributePc: Omit<HTMLAttributes<'img'>, 'src'> = {
  height: size.pc.height,
  loading: 'lazy',
  width: size.pc.width,
  ...imageProps,
};

const attributeSp: HTMLAttributes<'source'> = {
  height: size.sp.height,
  media: `(max-width: ${breakpoints.sp}px)`,
  width: size.sp.width,
};
---

<picture {...pictureProps}>
  {data.sp.ext !== '.svg' && (
    <source
      height={attributeSp.height}
      media={attributeSp.media}
      srcset={`${data.sp.assetDir}/${data.sp.name}.avif`}
      type="image/avif"
      width={attributeSp.width}
    />
  )}
  <source srcset={`${data.sp.assetDir}/${data.sp.name}${data.sp.ext}`} {...attributeSp} />

  {data.pc.ext !== '.svg' && (
    <source
      height={attributePc.height}
      srcset={`${data.pc.assetDir}/${data.pc.name}.avif`}
      type="image/avif"
      width={attributePc.width}
    />
  )}
  <img
    alt={alt}
    decoding="async"
    src={`${data.pc.assetDir}/${data.pc.name}${data.pc.ext}`}
    {...attributePc}
  />
</picture>
