---
import type { HTMLAttributes } from 'astro/types';

import { svgSpritePath } from '@root/project.config';
import { imageSize } from 'image-size';
import fs from 'node:fs';
import path from 'node:path';

import type { SvgSpriteNames } from '@/types/svg-sprite';

import { rootPath } from '@/helper/node/path';

export type Props = BaseProps &
  (
    | {
        decorative: false;
        label: string;
      }
    | {
        decorative?: true;
        label?: never;
      }
  );

type BaseProps = Omit<HTMLAttributes<'svg'>, 'aria-hidden' | 'aria-label' | 'role'> & {
  hash: SvgSpriteNames;
};

const { decorative = true, hash, label, ...restProps } = Astro.props;
const target = path.join(rootPath, `/src/assets/svg-sprite/${hash}.svg`);
const buffer = fs.readFileSync(target);

const { height, width } = imageSize(buffer);
const attribute = {
  viewBox: `0 0 ${width} ${height}`,
  ...restProps,
};
---

<svg
  aria-hidden={decorative ? 'true' : undefined}
  aria-label={decorative ? undefined : label}
  role={decorative ? undefined : 'img'}
  {...attribute}
>
  <use href={`${svgSpritePath}#${hash}`}></use>
</svg>
